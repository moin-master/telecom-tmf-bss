{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "env": {
    "BSS_HOST": "127.0.0.1",
    "BSS_PORT": "8060",
    "BSS_CONTEXT_PATH": "/telecom-tmf-bss",
    "UV_PROJECT_ENVIRONMENT": ".venv"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",

      "Bash(uv:*)",
      "Bash(uvx ruff:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(pytest:*)",
      "Bash(sqlite3:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git clone https://github.com/tmforum-apis/*)",
      "Bash(git -C specs/*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",

      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",

      "Bash(lsof -i:*)",
      "Bash(lsof -ti:*)",
      "Bash(kill:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -sS http://127.0.0.1:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api -X:*)",
      "Bash(gh api --method:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf /Users:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm /:*)",
      "Bash(rm ~:*)",
      "Bash(sudo:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh auth:*)",
      "Bash(git config --global:*)",
      "Bash(git remote set-url:*)",
      "Bash(curl:*|*sh)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(/etc/**)",
      "Write(/etc/**)"
    ],
    "additionalDirectories": []
  }
}
